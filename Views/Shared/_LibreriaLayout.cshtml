<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibreriaWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/libreria.css" asp-append-version="true" />
    <!-- Aggiungi Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* Stili per l'assistente AI */
        #aiAssistantButton {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1000;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
        }

            #aiAssistantButton:hover {
                transform: scale(1.1);
            }

        #aiAssistantWidget {
            display: none;
            position: fixed;
            bottom: 100px;
            right: 30px;
            width: 350px;
            height: 500px;
            z-index: 1000;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        #chatMessages {
            height: 380px;
            overflow-y: auto;
            padding: 15px;
            background-color: #f8f9fa;
        }

        .user-message {
            background-color: #e3f2fd;
            border-radius: 10px;
            padding: 8px 12px;
            margin-bottom: 10px;
            max-width: 80%;
            margin-left: auto;
        }

        .assistant-message {
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 8px 12px;
            margin-bottom: 10px;
            max-width: 80%;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">LibreriaWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Libroes" asp-action="Index">Libri</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Autores" asp-action="Index">Autori</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - LibreriaWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Bottone Assistente AI -->
    <button id="aiAssistantButton" class="btn btn-primary">
        <i class="fas fa-robot"></i>
    </button>

    <!-- Widget Chat -->
    <div id="aiAssistantWidget" class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Assistente Libreria</h5>
            <button id="closeAssistant" class="btn btn-sm btn-light">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="card-body p-0">
            <div id="chatMessages"></div>
            <div class="input-group p-3 border-top">
                <input type="text" id="userQuestion" class="form-control" placeholder="Chiedimi informazioni sui libri...">
                <button id="sendQuestion" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            // Toggle widget
            $('#aiAssistantButton').click(function () {
                $('#aiAssistantWidget').toggle();
            });

            // Chiudi widget
            $('#closeAssistant').click(function () {
                $('#aiAssistantWidget').hide();
            });

            // Invia messaggio
            function sendMessage() {
                const question = $('#userQuestion').val().trim();
                if (!question) return;

                // Aggiungi messaggio utente
                addMessage('Tu', question, 'user-message');
                $('#userQuestion').val('');

                // Risposta temporanea (sostituire con chiamata API)
                setTimeout(() => {
                    addMessage('Assistente', 'Ho ricevuto la tua domanda: "' + question + '". Attualmente sono in fase di sviluppo e presto potrò rispondere alle tue domande sui libri!', 'assistant-message');
                }, 500);
            }

            // Invio con click
            $('#sendQuestion').click(sendMessage);

            // Invio con Enter
            $('#userQuestion').keypress(function (e) {
                if (e.which === 13) {
                    sendMessage();
                }
            });

            function addMessage(sender, text, cssClass) {
                const messageHtml = `
                            <div class="${cssClass}">
                                <strong>${sender}:</strong>
                                <div>${text}</div>
                            </div>`;
                $('#chatMessages').append(messageHtml);
                $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>